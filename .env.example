# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Postgres: transaction pooler (6543) for the app, direct/session (5432) for migrations
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# The one email allowed to sign in
AUTH_ALLOWED_EMAIL=you@example.com
# Public origin used in magic links (set on Vercel to the production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_TOKEN=
MCP_TOKEN=
TOKEN_ENCRYPTION_KEY=
# Phase 2 (web push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
